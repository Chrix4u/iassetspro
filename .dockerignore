# ============================================================================
# iAssetsPro EAM — Docker Build Context Exclusions
# ============================================================================

# Dependencies (installed fresh inside Docker via bun install)
node_modules

# Build artifacts (regenerated during Docker build)
.next
.next/standalone
.out
build
dist

# Prisma prebuilt client (generated fresh in build stage)
prisma/prebuilt

# Environment and package-registry credential files must never enter build
# context. Match both repository-root and nested variants so new environment
# names (for example .env.staging) are fail-safe by default.
.env*
**/.env*
.npmrc
**/.npmrc
.yarnrc*
**/.yarnrc*
.netrc
**/.netrc
.ssh/
**/.ssh/

# Version control
.git
.gitignore
.gitattributes

# Docker files (not needed inside the image)
Dockerfile*
docker-compose*.yml
.dockerignore

# Database files (mounted as volumes)
db/*.db
db/*.db-journal

# Upload and download directories (mounted as volumes)
upload/
download/
public/uploads/

# Development and debug logs
*.log
dev.log
server.log
dev.out.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local development artifacts
local-*
.claude
.claudeignore
.z-ai-config

# Testing
test/
__tests__/
coverage/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
vitest.setup.tsx
vitest.config.ts

# Source analysis tools
source-analysis/
.source-analysis
.claude

# Skills directory
skills/

# Agent context (development only)
agent-ctx/

# Mini-services (independent deployments, not in the main container)
mini-services/

# Data files (not needed in image)
data/

# SQL dumps and migration scripts
*.sql
scripts/

# Documentation (not needed in runtime image)
*.md
!README.md

# Miscellaneous
.DS_Store
*.pem
*.key
*.crt
.vercel
cloudbuild.yaml
deploy-cloud-run.sh
DEPLOY.sh
deploy.sh

# Entry-point patches and start scripts (Docker uses its own CMD)
server.js
start.js
patch-server.js
entrypoint.js
activate-role-permissions.js
setup-server.sh

# Caddyfile (reverse proxy config, not needed inside container)
Caddyfile
