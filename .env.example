# =============================================================================
# iAssetsPro EAM — Production Environment Configuration
# =============================================================================
# Copy this file to your VPS at /home/z/my-project/.env
# Replace all placeholder values with your actual credentials
# NEVER commit this file to version control
# =============================================================================

# =============================================================================
# APPLICATION & RUNTIME
# =============================================================================
NODE_ENV=production
# PORT=3000                          # Optional, Next.js default is 3000
# HOSTNAME=0.0.0.0                    # Optional

# =============================================================================
# DATABASE — PostgreSQL (REQUIRED)
# =============================================================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://eam_user:CHANGE_ME_Strong_Password_Here@localhost:5432/iassetspro?schema=public

# Individual DB vars (fallback if DATABASE_URL is not set):
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=eam_user
# DB_PASSWORD=CHANGE_ME_Strong_Password_Here
# DB_NAME=iassetspro

# =============================================================================
# AUTHENTICATION & SECURITY (REQUIRED)
# =============================================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_Generate_With_openssl_rand_base64_32

# JWT secret for session tokens
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_Generate_With_openssl_rand_hex_32

# Encryption key for sensitive data (32 bytes hex)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_Generate_With_openssl_rand_hex_32

# Extra signing pepper for password hashing (optional)
# AUTH_PEPPER=CHANGE_ME_random_string

# =============================================================================
# PUBLIC APP CONFIG
# =============================================================================
NEXT_PUBLIC_APP_URL=https://iassetspro.lightworldtech.com
NEXT_PUBLIC_APP_NAME=iAssetsPro EAM
# NEXT_PUBLIC_API_URL=                  # Optional, defaults to same origin

# CORS origin — defaults to NEXT_PUBLIC_APP_URL
# CORS_ORIGIN=https://iassetspro.lightworldtech.com

# =============================================================================
# REDIS — For queues, caching, sessions (Optional — in-memory fallback if missing)
# =============================================================================
# REDIS_URL=redis://localhost:6379
# REDIS_KEY_PREFIX=iassetspro:

# =============================================================================
# SMTP / EMAIL (Optional — email features disabled without these)
# =============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@iassetspro.lightworldtech.com

# =============================================================================
# FILE STORAGE / UPLOADS (Optional)
# =============================================================================
# STORAGE_PATH=data/storage             # Local filesystem path for uploads
# CDN_BASE_URL=/api/files               # URL prefix for serving files
# MAX_UPLOAD_SIZE=52428800              # Max upload in bytes (default 50MB)
# FILE_UPLOAD_DIR=./uploads

# For S3-compatible storage (optional):
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=my-iassetspro-bucket
# S3_REGION=us-east-1

# =============================================================================
# WEBSOCKET NOTIFICATIONS (Optional)
# =============================================================================
# WS_NOTIFY_URL=http://localhost:3005   # Notification mini-service URL

# =============================================================================
# CRON / SCHEDULED TASK SECRETS (Recommended — insecure defaults if missing)
# =============================================================================
# Generate with: openssl rand -hex 24
PM_CRON_SECRET=CHANGE_ME_Generate_With_openssl_rand_hex_24
ESCALATION_SECRET=CHANGE_ME_Generate_With_openssl_rand_hex_24

# =============================================================================
# ADMIN DEFAULT ACCOUNT (Optional — only for initial seed)
# =============================================================================
# DEFAULT_ADMIN_USER=admin
# DEFAULT_ADMIN_PASSWORD=CHANGE_ME_initial_admin_password

# =============================================================================
# OBSERVABILITY & LOGGING (Optional)
# =============================================================================
LOG_LEVEL=info                          # trace | debug | info | warn | error | fatal
OTEL_SERVICE_NAME=iassetspro
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# =============================================================================
# MQTT — Industrial Connectivity (Optional)
# =============================================================================
# MQTT_BROKER_URL=mqtt://localhost:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# =============================================================================
# BUSINESS LOGIC (Optional)
# =============================================================================
# DEFAULT_LABOR_RATE_HOURS=50          # Default labor rate in GHS
# SESSION_TTL=86400                     # Session duration in seconds (default 24h)
# MAX_SESSIONS_PER_USER=5              # Max concurrent sessions per user

# =============================================================================
# AI INTEGRATION (Optional)
# =============================================================================
# Z_AI_API_KEY=your-api-key-here
